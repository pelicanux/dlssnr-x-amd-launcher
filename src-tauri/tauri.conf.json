{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DLSSNR X AMD",
  "version": "0.7.1",
  "identifier": "com.pelicano.dlssnr-installer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DLSSNR X AMD",
        "width": 1200,
        "height": 850,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Configuração do DLSS Neural Rendering para AMD Linux",
    "longDescription": "Configuração do DLSS Neural Rendering para AMD Linux",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/launcher.desktop",
        "files": {
          "/usr/bin/dlssnr-x-amd": "packaging/dlssnr-x-amd"
        }
      },
      "rpm": {
        "desktopTemplate": "packaging/launcher.desktop",
        "files": {}
      }
    }
  }
}
